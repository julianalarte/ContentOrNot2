{
  "manifest_version": 3,
  "name": "Content or not",
  "author": "Josep Silva, Julián Alarte",  
  "description": "__MSG_extensionDescription__",
  "version": "1.3",
  "icons": {
    "48": "icons/c3.png"
  },

  "permissions": ["notifications", "activeTab", "tabs", "webRequest"],

  "background": {
    "service_worker": "background-scripts/background.js"
  },

  "action": {
    "default_icon": "icons/c3.png",
    "browser_style": true,	
    "default_title": "__MSG_extensionDescription__"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": [ 
        "content-scripts/createNamespaces.js",
        "content-scripts/ConEx/misc/Misc.js",
        "content-scripts/ConEx/algorithm/ConEx/Config.js",
        "content-scripts/ConEx/algorithm/ConEx/ConEx.js",
        "content-scripts/ConEx/algorithm/ConEx/Content.js",		
        "content-scripts/ConEx/ContentExtractor.js",
        "content-scripts/browserOverlay.js",
        "content-scripts/ConEx/util/TreeSearch.js"	
      ]
    }
  ],
  
  "default_locale": "en"
}
